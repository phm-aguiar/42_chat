# ═══════════════════════════════════════
#  42 Chat Core — .env
# ═══════════════════════════════════════
# Copie de .env.example e preencha os valores.
# Alimenta o servidor Go e o docker-compose.yml.
# ⚠️ NUNCA comite o .env real.

# ── Servidor Go ────────────────────────

PORT=8080
DATABASE_URL=postgres://chat:***@localhost:5432/chat?sslmode=disable
JWT_SECRET=*** ── OAuth2 42 Intra ────────────────────
# ⚠️ Obrigatório para login. Pegue em https://profile.intra.42.fr/oauth/applications

FORTYTWO_CLIENT_ID=""
FORTYTWO_CLIENT_SECRET=""
FORTYTWO_REDIRECT_URI=""
FORTYTWO_API_URL=https://api.intra.42.fr

# ── Desenvolvimento Local ──────────────

DEV_MODE=true
DEV_USER=marvin

# ── PostgreSQL (docker-compose) ─────────

POSTGRES_USER=chat
POSTGRES_PASSWORD=""
POSTGRES_DB=chat
POSTGRES_PORT=5432
