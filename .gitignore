# Framework SDD Autônomo — .gitignore

# Secrets e ambiente
.env
*.env
.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/

# Go
bin/
*.test
.coverprofile
coverage.out
/server

# Obsidian (workspace-local, não versionar)
wiki/.obsidian/workspace.json
wiki/.obsidian/workspace-mobile.json
wiki/.env.tmp

# Sistema
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE
.idea/
.vscode/
.vite/
node_modules
.pnpm-store/
.playwright/
playwright-report/
test-results/
frontend/dist/
frontend/test-results/
test/e2e/reports/*.bak
